# Automatic text detection, normalization to LF in the repository
* text=auto

# Files executed or read on Linux: always LF, even after a clone on Windows
*.sh       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.tf       text eol=lf
*.tfvars   text eol=lf
*.j2       text eol=lf
*.py       text eol=lf
*.json     text eol=lf
*.md       text eol=lf
Dockerfile text eol=lf
hosts      text eol=lf
.gitignore text eol=lf

# Terraform lock file (generated by terraform init, versioned in git)
.terraform.lock.hcl text eol=lf

# Binary files: never modified by Git
*.pem      binary
*.png      binary
*.jpg      binary
*.pdf      binary
