---
# ============================================================
# vault.yml.example
#
# Template for the secrets of the [master] group, loaded
# automatically by Ansible (group_vars/master/) on all
# plays targeting the master group (therefore also on
# groups['master'][0], used by install-monitoring.yml).
#
# Usage:
#   1. Copy this file:
#        cp ansible/group_vars/master/vault.yml.example \
#           ansible/group_vars/master/vault.yml
#   2. Replace the value below with a real password.
#   3. Encrypt the file:
#        ansible-vault encrypt ansible/group_vars/master/vault.yml
#   4. Run the playbooks with --ask-vault-pass, or
#      --vault-password-file=<path_to_password_file> (file to
#      NEVER commit, already covered by .gitignore).
#
# vault.yml (once created, encrypted or not) is ignored by Git -
# only this .example, with no real secret, is versioned.
# ============================================================
grafana_admin_password: "CHANGE_ME_before_ansible-vault_encrypt"
